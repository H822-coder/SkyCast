{
  "expo": {
    "name": "SkyCast",
    "slug": "skycast",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skycast",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SkyCast to use your location to show local weather."
        }
      ]
    ]
  }
}